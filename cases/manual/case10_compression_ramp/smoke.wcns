# Chapter 5: physical facts and reconstruction choices in docs/chapter5-v2.5-research.md.
# Server production configuration. Do not launch long production jobs on the local workstation.
schema_version = 2
case.name = ramp-smoke
mesh.path = grids/ramp_smoke.cgns
algorithm.profile = scmm6_wcns
algorithm.reconstruction = mdcd_hybrid
algorithm.reconstruction_variables = characteristic
algorithm.mdcd.disp = 0.0463783
algorithm.mdcd.diss = 0.01
algorithm.riemann = roe
gas.gamma = 1.4
gas.specific_gas_constant = 287.05000000000001
reference.velocity = 588.09809449614784
reference.density = 1
reference.temperature = 170
reference.length = 0.00060959999999999996
reference.viscosity = 2.2690164456003274e-05
transport.model = sutherland
transport.prandtl = 0.72
transport.sutherland.reference_viscosity_ratio = 1
transport.sutherland.temperature_ratio = 0.64941176470588236
turbulence.model = none
time.integrator = ssprk3
preconditioner.type = none
robustness.enabled = true
robustness.max_local_recomputations = 3
robustness.max_step_retries = 4
robustness.time_step_reduction = 0.5
robustness.minimum_time_step = 1e-12
partition.mode = auto_split
partition.allow_idle_ranks = false
partition.max_load_ratio = 1.2
partition.min_cells_per_active_direction = 6
geometry.metric.maximum_reference_relative_difference = 0.9
initial.type = compression_ramp
boundary.default = farfield
boundary.wall.type = no_slip_isothermal_wall
boundary.farfield.type = farfield
boundary.farfield.rho = 1
boundary.farfield.u = 1
boundary.farfield.v = 0
boundary.farfield.temperature = 1
boundary.wall.wall_temperature = 1.8999999999999999
boundary.inlet.type = inflow
boundary.inlet.rho = 1
boundary.inlet.u = 1
boundary.inlet.temperature = 1
boundary.outlet.type = outflow
source.enabled = true
source.models = ramp_trip
# Dimensionless force per volume. Adaptation; NOT a recovered published amplitude.
source.ramp_trip.amplitude = 5
source.ramp_trip.span = 6
benchmark.type = compression_ramp
benchmark.statistics.start = 0
benchmark.statistics.end = 4000
benchmark.write_every_steps = 1
benchmark.history_every_steps = 1
# Fixed provisional Cartesian probes; coordinates actually sampled are written to CSV.
# For the thesis half-BL-height PSD, relocate probes after a pilot mean profile.
benchmark.probes = 80,0.01,3,88,0.01,3,95,0.01,3,105,2.237,3,120,8.92,3,80,0.5,3
run.mode = unsteady
run.viscous = true
run.cfl = 0.1
run.max_steps = 3
run.t_end = 4000
run.max_wall_time = 120
output.directory = output/ramp-smoke
output.allow_existing = false
output.dimensional = false
output.field.enabled = true
output.field.format = cgns
output.field.every_time = 20
output.field.write_initial = false
output.field.write_final = true
output.field.quantities = rho,u,v,w,p,T,mach,Q,vorticity_x,vorticity_y,vorticity_z
output.history.enabled = true
output.history.every_steps = 1000
output.history.write_initial = false
output.history.write_final = true
output.statistics.enabled = true
output.statistics.every_steps = 1000
output.statistics.write_initial = false
output.statistics.write_final = true
output.statistics.quantities = total_mass,total_momentum_x,total_energy
output.checkpoint.enabled = true
output.checkpoint.every_time = 20
output.checkpoint.write_initial = false
output.checkpoint.write_final = true
