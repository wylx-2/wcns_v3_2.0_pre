# Physical setup: supplied thesis section 5.3.4, Re_h=1400, Ma_b=0.1.
# Mesh distribution, thermal BC and runtime controls are documented implementation choices.
schema_version = 2
case.name = hill-re1400-iles
mesh.path = grids/hill_88x48x24.cgns
algorithm.profile = scmm6_wcns
algorithm.reconstruction = mdcd_hybrid
algorithm.reconstruction_variables = primitive
algorithm.mdcd.disp = 0.0463783
algorithm.mdcd.diss = 0.01
algorithm.riemann = roe_all_speed
algorithm.roe_all_speed.reference_mach = 0.1
algorithm.roe_all_speed.dissipation_scale = 0.02
algorithm.roe_all_speed.pressure_coefficient = 0.05
gas.gamma = 1.4
gas.specific_gas_constant = 1.0
reference.velocity = 1.0
reference.density = 1.0
reference.temperature = 71.42857142857143
reference.length = 1.0
reference.viscosity = 0.0007142857142857143
transport.model = constant
transport.prandtl = 0.72
transport.constant.viscosity_ratio = 1.0
turbulence.model = none
time.integrator = ssprk3
preconditioner.type = none
robustness.enabled = false
partition.mode = auto_split
partition.allow_idle_ranks = false
partition.max_load_ratio = 1.2
partition.min_cells_per_active_direction = 6
initial.type = periodic_hill
initial.rho = 1.0
initial.temperature = 1.0
initial.bulk_velocity = 1.0
initial.perturbation_amplitude = 0.05
boundary.default = no_slip_isothermal_wall
boundary.bottom.type = no_slip_isothermal_wall
boundary.bottom.wall_temperature = 1.0
boundary.top.type = no_slip_isothermal_wall
boundary.top.wall_temperature = 1.0
source.enabled = true
source.models = pressure_gradient
source.pressure_gradient.x = 0.01
hill.enabled = true
hill.bulk_velocity = 1.0
hill.density = 1.0
hill.controller_time = 1.0
hill.force_limit = 0.5
hill.statistics.start = 100.0
hill.statistics.end = 1000.0
hill.write_every_steps = 100
run.mode = unsteady
run.viscous = true
run.cfl = 0.25
run.max_steps = 100000000
run.t_end = 1000.0
run.max_wall_time = 0
output.directory = output/hill-production-resumed
output.allow_existing = false
output.dimensional = false
output.field.enabled = true
output.field.format = cgns
output.field.every_time = 10.0
output.field.write_initial = false
output.field.write_final = true
output.field.quantities = rho,u,v,w,p,T
output.history.enabled = true
output.history.every_steps = 100
output.history.write_initial = true
output.history.write_final = true
output.statistics.enabled = true
output.statistics.every_steps = 100
output.statistics.write_initial = true
output.statistics.write_final = true
output.statistics.quantities = total_mass,total_momentum_x,total_energy
output.checkpoint.enabled = true
output.checkpoint.every_time = 10.0
output.checkpoint.write_initial = false
output.checkpoint.write_final = true

restart.path = output/hill-production/hill-re1400-iles.checkpoint.latest.cgns
restart.mode = strict
