# HIT initialization update 2026-10-07. See HIT初始化与预演化说明.md.
# SMOKE ONLY: 0.001 preparation, max 20 preparation steps + 3 production steps.
# WCNS v2.6; 3D periodic ILES, no explicit SGS/wall model.
# Production configurations are for a compute server; local test uses smoke.wcns only.
schema_version = 2
case.name = hit-decay-prepared_smoke
mesh.path = grids/hit16.cgns
algorithm.profile = scmm6_wcns
algorithm.reconstruction = mdcd_hybrid
algorithm.reconstruction_variables = characteristic
algorithm.mdcd.disp = 0.0463783
algorithm.mdcd.diss = 0.001
algorithm.riemann = roe_all_speed
algorithm.roe_all_speed.reference_mach = 0.1
algorithm.roe_all_speed.dissipation_scale = 0.02
algorithm.roe_all_speed.pressure_coefficient = 0.05
gas.gamma = 1.4
gas.specific_gas_constant = 1
reference.velocity = 0.27189336144893272
reference.density = 1
reference.temperature = 5.2804285714285708
reference.length = 0.55879999999999996
reference.viscosity = 1.5e-05
transport.model = constant
transport.constant.viscosity_ratio = 1
transport.prandtl = 0.72
turbulence.model = none
time.integrator = ssprk3
preconditioner.type = none
robustness.enabled = false
partition.max_load_ratio = 1.2
partition.mode = auto_split
partition.allow_idle_ranks = false
partition.min_cells_per_active_direction = 6
source.enabled = false
initial.type = hit
boundary.default = periodic
hit.type = decay
hit.n = 16
hit.length = 1
hit.seed = 20261003
hit.spectrum_file = reference/cbc_spectrum_42_nondimensional.dat
# cutoff=0 means spherical cutoff N/3 in integer wave-number units.
hit.cutoff = 0
hit.forcing = constant_power
hit.forcing_power = 0.103
hit.forcing_kmax = 2
hit.remove_mean_acceleration = true
hit.thermostat = false
hit.statistics.start = 0
hit.statistics.end = 0.31885676024465742
hit.sample_every_steps = 1
hit.write_every_samples = 1
hit.sample_times = 0,0.13841843855582028,0.31885676024465742
run.mode = unsteady
run.viscous = true
run.cfl = 0.2
run.max_steps = 3
run.t_end = 0.31885676024465742
run.max_wall_time = 120
output.directory = output/hit-decay-prepared_smoke
output.allow_existing = false
output.dimensional = false
output.field.enabled = true
output.field.format = cgns
output.field.every_time = 0.15942838012232871
output.field.write_initial = true
output.field.write_final = true
output.field.quantities = rho,u,v,w,p,T
output.history.enabled = true
output.history.every_steps = 100
output.statistics.enabled = true
output.statistics.every_steps = 100
output.statistics.quantities = total_mass,total_momentum_x,total_momentum_y,total_momentum_z,total_energy
output.checkpoint.enabled = true
output.checkpoint.every_time = 0.15942838012232871
output.checkpoint.write_initial = true
output.checkpoint.write_final = true
hit.initialization = shell_spectrum
hit.preparation.time = 0.001
hit.preparation.max_steps = 20
