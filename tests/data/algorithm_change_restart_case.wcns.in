schema_version = 1
case.name = algorithm-change-restart
mesh.path = @CMAKE_CURRENT_BINARY_DIR@/generated_partition_2d.cgns
algorithm.profile = phenglei_wcns
algorithm.reconstruction = weno_js
algorithm.reconstruction_variables = primitive
algorithm.riemann = rusanov
gas.gamma = 1.4
gas.molar_mass = 0.029
reference.velocity = 340.0
reference.density = 1.225
reference.temperature = 288.15
reference.length = 1.0
reference.viscosity = 1.7894e-5
partition.mode = auto_split
partition.allow_idle_ranks = false
partition.max_load_ratio = 1.2
partition.min_cells_per_active_direction = 8
initial.type = uniform
initial.rho = 1.0
initial.u = 0.2
initial.v = 0.0
initial.w = 0.0
initial.temperature = 1.0
boundary.default = farfield
source.enabled = false
run.mode = steady
run.viscous = false
run.cfl = 0.1
run.max_steps = 3
steady.min_steps = 1
steady.consecutive_checks = 1
output.directory = @CMAKE_CURRENT_BINARY_DIR@/algorithm-change-restart
output.allow_existing = true
output.dimensional = false
output.field.enabled = true
output.field.format = cgns
output.field.write_initial = true
output.field.write_final = false
output.field.quantities = rho,u,v,w,p,T,rho_u,rho_v,rho_w,rho_E
output.history.enabled = false
output.statistics.enabled = false
output.checkpoint.enabled = true
output.checkpoint.write_initial = true
output.checkpoint.write_final = false
restart.path = @CMAKE_CURRENT_BINARY_DIR@/checkpoint-validation/checkpoint-freestream.checkpoint.latest.cgns
restart.mode = algorithm_change
