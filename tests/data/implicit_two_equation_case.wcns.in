schema_version = 2
case.name = implicit-@WCNS_TWO_EQUATION_CASE@
mesh.path = @CMAKE_CURRENT_BINARY_DIR@/generated_partition_2d.cgns
algorithm.profile = phenglei_wcns
algorithm.reconstruction = linear5
algorithm.reconstruction_variables = characteristic
algorithm.riemann = roe
robustness.enabled = false
turbulence.model = @WCNS_TWO_EQUATION_MODEL@
turbulence.prandtl = 0.9
turbulence.wall_treatment = @WCNS_TWO_EQUATION_WALL@
turbulence.freestream.intensity = 0.01
turbulence.freestream.length_scale = 0.1
turbulence.model_floor = 1e-12
turbulence.two_equation.source_treatment = local_implicit
@WCNS_TWO_EQUATION_WALL_LINES@
@WCNS_TWO_EQUATION_RESTART_LINE@
@WCNS_TWO_EQUATION_TIME_LINES@
preconditioner.type = none
gas.gamma = 1.4
gas.molar_mass = 0.029
reference.velocity = 34.0
reference.density = 1.225
reference.temperature = 288.15
reference.length = 1.0
reference.viscosity = 1.7894e-5
partition.mode = auto_split
partition.allow_idle_ranks = false
partition.max_load_ratio = 1.2
partition.min_cells_per_active_direction = 8
initial.type = uniform
initial.rho = 1.0
initial.u = 0.2
initial.v = 0.0
initial.w = 0.0
initial.temperature = 1.0
boundary.default = no_slip_adiabatic_wall
source.enabled = false
run.mode = @WCNS_TWO_EQUATION_MODE@
@WCNS_TWO_EQUATION_RUN_LINES@
run.viscous = true
run.cfl = 0.001
run.max_steps = @WCNS_TWO_EQUATION_MAX_STEPS@
steady.min_steps = @WCNS_TWO_EQUATION_MIN_STEPS@
steady.l2_absolute = 1e6
steady.linf_absolute = 1e6
output.directory = @WCNS_TWO_EQUATION_OUTPUT_DIRECTORY@
output.allow_existing = true
output.dimensional = false
output.field.enabled = true
output.field.format = cgns
output.field.write_final = true
output.field.quantities = rho_u,rho_v,rho_w,rho_E,@WCNS_TWO_EQUATION_QUANTITIES@
output.history.enabled = true
output.history.format = txt
output.history.write_final = true
output.statistics.enabled = false
output.checkpoint.enabled = @WCNS_TWO_EQUATION_CHECKPOINT@
output.checkpoint.write_final = true
