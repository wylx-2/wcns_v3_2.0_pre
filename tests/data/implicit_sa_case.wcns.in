schema_version = 2
case.name = implicit-sa-steady
mesh.path = @CMAKE_CURRENT_BINARY_DIR@/generated_partition_2d.cgns
algorithm.profile = phenglei_wcns
algorithm.reconstruction = linear5
algorithm.reconstruction_variables = characteristic
algorithm.riemann = hllc
robustness.enabled = false
turbulence.model = sa_neg
turbulence.prandtl = 0.9
turbulence.wall_treatment = resolved
turbulence.sa.farfield_nu_tilde_ratio = 3
turbulence.sa.source_treatment = local_implicit
time.integrator = lu_sgs
time.physical.scheme = bdf2
time.dual_time.max_iterations = 20
time.dual_time.absolute_tolerance = 1e-10
time.dual_time.relative_tolerance = 1e-8
time.dual_time.cfl = 2
lu_sgs.sweeps = 1
lu_sgs.jacobian = scalar_spectral
lu_sgs.relaxation = 1
preconditioner.type = none
gas.gamma = 1.4
gas.molar_mass = 0.029
reference.velocity = 34.0
reference.density = 1.225
reference.temperature = 288.15
reference.length = 1.0
reference.viscosity = 1.7894e-5
partition.mode = auto_split
partition.allow_idle_ranks = false
partition.max_load_ratio = 1.2
partition.min_cells_per_active_direction = 8
initial.type = uniform
initial.rho = 1.0
initial.u = 0.2
initial.v = 0.0
initial.w = 0.0
initial.temperature = 1.0
boundary.default = no_slip_adiabatic_wall
source.enabled = false
run.mode = steady
run.viscous = true
run.cfl = 0.5
run.max_steps = 1
steady.min_steps = 1
steady.l2_absolute = 1e6
steady.linf_absolute = 1e6
output.directory = @CMAKE_CURRENT_BINARY_DIR@/implicit-sa-steady
output.allow_existing = true
output.dimensional = false
output.field.enabled = false
output.history.enabled = false
output.statistics.enabled = false
output.checkpoint.enabled = false
