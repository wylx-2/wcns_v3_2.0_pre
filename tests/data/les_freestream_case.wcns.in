schema_version = 2
case.name = les-@WCNS_LES_MODEL@
mesh.path = @CMAKE_CURRENT_BINARY_DIR@/generated_periodic_3d.cgns
algorithm.profile = phenglei_wcns
algorithm.reconstruction = weno_z
algorithm.reconstruction_variables = characteristic
algorithm.riemann = roe
turbulence.model = @WCNS_LES_MODEL@
les.filter.type = box3_tensor
les.filter.width_ratio = 1
les.sgs_prandtl = 0.9
@WCNS_LES_MODEL_LINES@
time.integrator = lu_sgs
time.physical.scheme = bdf2
time.physical.step = 0.001
time.dual_time.max_iterations = 2
time.dual_time.absolute_tolerance = 1e6
time.dual_time.relative_tolerance = 1e-8
time.dual_time.cfl = 1
lu_sgs.sweeps = 1
lu_sgs.jacobian = scalar_spectral
lu_sgs.relaxation = 0.5
preconditioner.type = none
robustness.enabled = false
gas.gamma = 1.4
gas.molar_mass = 0.029
reference.velocity = 34
reference.density = 1.225
reference.temperature = 288.15
reference.length = 1
reference.viscosity = 1.7894e-5
partition.mode = auto_split
partition.allow_idle_ranks = false
partition.max_load_ratio = 2
partition.min_cells_per_active_direction = 4
initial.type = uniform
initial.rho = 1
initial.u = 0
initial.v = 0
initial.w = 0
initial.temperature = 1
boundary.default = farfield
source.enabled = false
run.mode = unsteady
run.t_end = 0.001
run.viscous = true
run.cfl = 1
run.max_steps = 1
output.directory = @CMAKE_CURRENT_BINARY_DIR@/les-@WCNS_LES_MODEL@-r@WCNS_LES_RANK_LABEL@
output.allow_existing = true
output.dimensional = false
output.field.enabled = false
output.history.enabled = false
output.statistics.enabled = false
output.checkpoint.enabled = false
