schema_version = 2
case.name = les-boundary-@WCNS_LES_BOUNDARY_RANK@
mesh.path = @CMAKE_CURRENT_BINARY_DIR@/xz_plane_statistics_mesh.cgns
algorithm.profile = phenglei_wcns
algorithm.reconstruction = weno_z
algorithm.reconstruction_variables = characteristic
algorithm.riemann = roe
turbulence.model = wale
les.filter.type = box3_tensor
les.filter.width_ratio = 1
les.wale.cw = 0.325
les.sgs_prandtl = 0.9
time.integrator = lu_sgs
time.physical.scheme = bdf2
time.physical.step = 1e-6
time.dual_time.max_iterations = 2
time.dual_time.absolute_tolerance = 1e6
time.dual_time.relative_tolerance = 1e-8
time.dual_time.cfl = 1
lu_sgs.sweeps = 1
lu_sgs.jacobian = scalar_spectral
lu_sgs.relaxation = 0.5
preconditioner.type = none
robustness.enabled = false
gas.gamma = 1.4
gas.specific_gas_constant = 1
reference.velocity = 1
reference.density = 1
reference.temperature = 1
reference.length = 1
reference.viscosity = 1e-5
partition.mode = auto_split
partition.allow_idle_ranks = false
partition.max_load_ratio = 2
partition.min_cells_per_active_direction = 4
initial.type = uniform
initial.rho = 1
initial.u = 0.2
initial.v = 0
initial.w = 0
initial.temperature = 1
boundary.default = farfield
boundary.bottom.type = no_slip_adiabatic_wall
boundary.top.type = no_slip_adiabatic_wall
source.enabled = false
run.mode = unsteady
run.t_end = 1e-6
run.viscous = true
run.cfl = 1
run.max_steps = 1
output.directory = @CMAKE_CURRENT_BINARY_DIR@/les-boundary-equivalence
output.allow_existing = true
output.dimensional = false
output.field.enabled = false
output.history.enabled = false
output.statistics.enabled = false
output.boundary.enabled = true
output.boundary.format = txt
output.boundary.write_initial = true
output.boundary.write_final = true
output.boundary.patches = bottom,top
output.boundary.quantities = Cp,Cf,wall_distance,friction_velocity,wall_y_plus,wall_y_plus_class,mu_model_over_mu
output.boundary.reference_pressure = 1
output.boundary.reference_density = 1
output.boundary.reference_velocity_x = 0.2
output.boundary.reference_velocity_y = 0
output.boundary.reference_velocity_z = 0
output.boundary.reference_area = 1
output.boundary.reference_length = 1
output.boundary.moment_center_x = 0.5
output.boundary.moment_center_y = 0.5
output.boundary.moment_center_z = 0.5
output.boundary.drag_direction_x = 1
output.boundary.drag_direction_y = 0
output.boundary.drag_direction_z = 0
output.boundary.lift_direction_x = 0
output.boundary.lift_direction_y = 1
output.boundary.lift_direction_z = 0
output.boundary.tangent_direction_x = 1
output.boundary.tangent_direction_y = 0
output.boundary.tangent_direction_z = 0
output.checkpoint.enabled = false
